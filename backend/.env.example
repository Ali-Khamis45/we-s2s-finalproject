# Copy to backend/.env and edit. Every setting is optional — the defaults below
# are what the code uses. Prefix is SCC_.

# ---- app ----
# SCC_DEBUG=false
# SCC_LOG_LEVEL=INFO
# SCC_LOG_JSON=false
# SCC_CORS_ORIGINS=http://localhost:5173

# ---- Live Coach (Moshi, owned by Track M / task M2) ----
# Set false to develop the cascade without Moshi running. The app degrades to
# Knowledge Mode on its own when this is unreachable, so leaving it true is
# safe — it just costs a connect timeout on the first probe.
# SCC_MOSHI_ENABLED=true
# SCC_MOSHI_URL=ws://127.0.0.1:8998/api/chat
# SCC_MOSHI_SAMPLE_RATE=24000

# ---- STT (Whisper, task A7) ----
# CPU on purpose: the GPU belongs to Moshi.
#
# "base" is the measured default — 3.4x faster than "small" and slightly more
# accurate on word timings, which is what the acoustic branch actually needs.
# Run backend/scripts/bench_whisper.py to re-derive on your hardware.
#
# NEVER set this to "tiny": it transcribed "I-I-I want ... water" as
# "I want water please", erasing the repetitions and the 1.4 s block outright.
# SCC_WHISPER_MODEL=base
# SCC_WHISPER_DEVICE=cpu
# SCC_WHISPER_COMPUTE_TYPE=int8

# ---- TTS (Kokoro, task A8) ----
# SCC_TTS_VOICE=af_heart
# Pacing bounds. The coach slows toward the minimum when the analyzer reports
# a long block — this is the acoustic branch reaching the output.
# SCC_TTS_SPEED_MIN=0.75
# SCC_TTS_SPEED_MAX=1.15

# ---- Dysfluency analyzer (Track M / task M4) ----
# Point at Track M's trained SEP-28k classifier when it exists. Unset, the
# heuristic backend runs instead — usable for development, never citable in
# the thesis. Check `analyzer` in GET /api/status to see which is active.
# SCC_DYSFLUENCY_MODEL_PATH=../ml/dysfluency/checkpoints/wav2vec2-sep28k
# SCC_DYSFLUENCY_THRESHOLD=0.5

# ---- RAG (tasks A9, A11) ----
# SCC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# SCC_RETRIEVAL_K=4
# Best-match score below which a question is treated as outside the corpus.
# bge embeddings have a high similarity floor — unrelated text scores ~0.35-0.48,
# not ~0. Anything below ~0.5 admits everything and is no gate at all. Re-measure
# with `GET /api/corpus/search?q=...` once the real corpus exists, and again after
# any change to the embedding model. See the note in app/core/config.py.
# SCC_RETRIEVAL_MIN_SCORE=0.55

# ---- LLM (llama.cpp, OpenAI-compatible) ----
# Start with:
#   llama-server -m qwen2.5-3b-instruct-q4_k_m.gguf --port 8080 -c 4096
# SCC_LLM_BASE_URL=http://127.0.0.1:8080/v1
# SCC_LLM_MODEL=qwen2.5-3b-instruct-q4_k_m
# Flip to "finetuned" once Track M's M8 checkpoint is deployed. Written onto
# every turn, so the M9 comparison can tell which model produced what.
# SCC_LLM_VARIANT=base

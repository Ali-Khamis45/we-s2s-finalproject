# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Node / React ----
node_modules/
dist/
build/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# ---- Environment & secrets ----
.env
.env.*
!.env.example

# ---- Models & weights (never commit; document how to fetch instead) ----
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
# Root-scoped: must not swallow backend/app/models/, which is source code.
/models/
ml/moshi/weights/
ml/moshi/weights-q8/
ml/moshi/weights-q4/
# M1: third-party Candle clone, downloaded model weights (auto-fetched
# by moshi-backend into the HF cache, not here, but kept as a safeguard),
# and the local dev TLS cert.
ml/moshi/candle-moshi/
# M2: bridge.py's own runtime logs (not source, regenerated per run).
ml/moshi/_bench_bridge.log
ml/finetuning/checkpoints/
ml/dysfluency/checkpoints/
ml/finetuning/adapters/
# M8: prebuilt llama.cpp binaries, fetched by hand (not built from source in
# this repo) -- see ml/finetuning/llama.cpp/README.md.
ml/finetuning/llama.cpp/*.exe
ml/finetuning/llama.cpp/*.dll
# M6: generated dataset (regenerated from the corpus, not source).
data/finetuning/
# M8: merged fp16 model (regenerated from the base model + adapter) and
# GGUF conversion output.
ml/finetuning/merged/
ml/finetuning/gguf/
# M8: llama.cpp source clone, fetched by hand for convert_hf_to_gguf.py
# (the prebuilt binary release ships compiled exes only, not this script).
ml/finetuning/llama.cpp-src/

# ---- Data ----
# SEP-28k audio is fetched from source podcasts, never redistributed.
data/sep28k/audio/
data/fluencybank/
# M3: third-party clone of apple/ml-stuttering-events-dataset, vendored for
# its label CSVs only -- not project source.
ml/dysfluency/sep28k-src/
data/chroma/**
!data/chroma/.gitkeep
data/corpus/**
!data/corpus/.gitkeep
!data/corpus/SOURCES.md

# ---- Design references ----
# Third-party template kept locally as a colour reference only (see
# design/UI_REBUILD_PROMPT.md). 5.5 MB of Bootstrap we do not ship.
design/*.zip

# ---- Evaluation runs ----
# Regenerable, and results.json holds every generation. The baseline table that
# matters lives in ml/evaluation/README.md.
ml/evaluation/results*/

# ---- Runtime artifacts ----
# Any database, under any suffix. The bare *.db rule did not cover a .bak
# copy, and one got committed — a dev database holding practice transcripts.
# Nothing in this repository should ever hold somebody's speech data.
*.db
*.db.*
*.sqlite3
*.sqlite3.*
*.wav
*.mp3
*.opus
logs/
outputs/
.cache/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
